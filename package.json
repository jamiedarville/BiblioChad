{
  "name": "bibliochad",
  "private": true,
  "version": "0.1.2",
  "description": "Workspace scripts for the BiblioChad desktop app",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "icons": "tauri icon assets/icon.png --output src-tauri/icons",
    "android:init": "bash scripts/android/init.sh",
    "android:dev": "tauri android dev",
    "android:apk": "tauri android build --apk --debug --target aarch64 --ci",
    "android:bundle": "bash scripts/android/bundle.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0"
  }
}
