{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BiblioChad",
  "version": "0.1.0",
  "identifier": "app.bibliochad.reader",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BiblioChad",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost bibliochad: http://bibliochad.localhost",
        "img-src": "'self' data: blob: bibliochad: http://bibliochad.localhost",
        "style-src": "'self' 'unsafe-inline' blob: data: bibliochad: http://bibliochad.localhost",
        "font-src": "'self' data: blob: bibliochad: http://bibliochad.localhost",
        "frame-src": "'self' blob: bibliochad: http://bibliochad.localhost",
        "media-src": "'self' blob: data:",
        "script-src": "'self'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Education",
    "fileAssociations": [
      { "ext": ["epub"], "name": "EPUB book", "mimeType": "application/epub+zip", "role": "Viewer" },
      { "ext": ["pdf"], "name": "PDF document", "mimeType": "application/pdf", "role": "Viewer", "rank": "Alternate" }
    ],
    "shortDescription": "Finish the book.",
    "longDescription": "An ebook reader whose library is your Google Drive folder tree. Reads PDF and EPUB, remembers where you stopped.",
    "copyright": "BiblioChad contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/pdfium/*": "pdfium/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
